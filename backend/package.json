{
    "name": "careline-backend",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "start": "node --env-file-if-exists=.env server.js",
        "dev": "node --env-file-if-exists=.env --watch server.js",
        "seed": "node --env-file-if-exists=.env scripts/seed.js",
        "test": "node --test tests/*.test.js",
        "test:integration": "node --env-file-if-exists=.env --test tests/integration.test.js",
        "check:db": "node --env-file-if-exists=.env scripts/check-db.js",
        "create-admin": "node --env-file-if-exists=.env scripts/create-admin.js",
        "reset-password": "node --env-file-if-exists=.env scripts/reset-password.js",
        "check:smtp": "node --env-file-if-exists=.env scripts/check-smtp.js",
        "db": "node --env-file-if-exists=.env scripts/clearDatabase.js",
        "db:clear": "node --env-file-if-exists=.env scripts/clearDatabase.js",
        "cd:clear": "node --env-file-if-exists=.env scripts/clearDatabase.js",
        "db:seed": "node scripts/seedDatabase.js"
    },
    "engines": {
        "node": ">=22"
    },
    "dependencies": {
        "bcryptjs": "^3.0.2",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.6",
        "express": "^4.21.2",
        "express-rate-limit": "^7.5.0",
        "helmet": "^8.1.0",
        "jsonwebtoken": "^9.0.2",
        "mongoose": "^8.24.5",
        "multer": "^2.0.2",
        "nodemon": "^3.1.14",
        "nodemailer": "latest"
    },
    "description": "",
    "main": "app.js",
    "directories": {
        "test": "tests"
    },
    "keywords": [],
    "author": "",
    "license": "ISC"
}
