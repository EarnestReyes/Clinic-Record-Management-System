{
  "name": "careline-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --env-file-if-exists=.env --watch server.js",
    "seed": "node --env-file-if-exists=.env scripts/seed.js",
    "test": "node --test tests/*.test.js",
    "test:integration": "node --env-file-if-exists=.env --test tests/integration.test.js",
    "check:db": "node --env-file-if-exists=.env scripts/check-db.js",
    "create-admin": "node --env-file-if-exists=.env scripts/create-admin.js",
    "reset-password": "node --env-file-if-exists=.env scripts/reset-password.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "express": "^4.21.2",
    "mongoose": "^8.19.1",
    "bcryptjs": "^3.0.2",
    "jsonwebtoken": "^9.0.2",
    "cors": "^2.8.5",
    "helmet": "^8.1.0",
    "express-rate-limit": "^7.5.0",
    "cookie-parser": "^1.4.7",
    "multer": "^2.0.2"
  }
}
