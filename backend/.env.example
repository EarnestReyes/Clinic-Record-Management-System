
MONGODB_URI=

JWT_SECRET=

PORT=
# Exact comma-separated frontend origins. Update the LAN IP if it changes.
# Production: set NODE_ENV=production and use only your deployed HTTPS origins.
# Origin only: do not append /#dashboard. Local development may append ,http://localhost:5173.
CLIENT_URL=https://clinic-record-management-system.vercel.app
# Optional comma-separated exact HTTPS preview origins. No wildcard domains.
TRUSTED_PREVIEW_ORIGINS=
NODE_ENV=
# 1 on Render (nearest ingress); 0 when Node is accessed directly.
TRUST_PROXY_HOPS=0

# Historical optional private email gateway hook; Gmail SMTP is the intended transport.
# Do not configure another email transport without explicit approval.
# HTTPS POST, Authorization: Bearer <secret>, JSON {to, subject, text}.
# Gateway must send email, disable click tracking and never log request bodies.
# Reset links use the FIRST CLIENT_URL origin and expire after 15 minutes.
PASSWORD_RESET_EMAIL_WEBHOOK_URL=
PASSWORD_RESET_EMAIL_WEBHOOK_SECRET=

SEED_PASSWORD=

MONGODB_TEST_URI=

# Manual development/test cleanup only. Never copy a production URI here.
# Must match an explicitly reviewed entry in config/databaseCleanupAllowlist.json.
# NODE_ENV must be development or test. The application MONGODB_URI is not used.
# Example URI format (placeholders must be replaced after independent review):
# mongodb+srv://<TEST_USER>:<ENCODED_PASSWORD>@<APPROVED_TEST_HOST>/<APPROVED_TEST_DATABASE>?retryWrites=true&w=majority
# Exact approval fields live in JSON, not in additional environment variables:
# {"environment":"test","server":"mongodb+srv://<APPROVED_TEST_HOST>","database":"<APPROVED_TEST_DATABASE>"}
# See .env.cleanup.example and config/databaseCleanupAllowlist.example.json.
CARELINE_CLEANUP_URI=

ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Gmail SMTP (optional; takes priority over the email webhook).
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
