# TEMPLATE ONLY. No target is approved by this file.
# Do not overwrite backend/.env or reuse its application credentials.
# The npm commands normally load .env, not .env.cleanup.
# To use a separate local file explicitly, follow DATABASE_CLEANUP.md.
NODE_ENV=test
CARELINE_CLEANUP_URI=mongodb+srv://<TEST_DB_USER>:<URL_ENCODED_TEST_DB_PASSWORD>@<APPROVED_TEST_CLUSTER_HOST>/<APPROVED_DISPOSABLE_DATABASE>?retryWrites=true&w=majority

# The hostname and database above must match a reviewed JSON allowlist entry:
# environment: test
# server: mongodb+srv://<APPROVED_TEST_CLUSTER_HOST>
# database: <APPROVED_DISPOSABLE_DATABASE>
# These are JSON fields, not extra environment-variable names.
# MONGODB_URI, MONGODB_TEST_URI, JWT_SECRET and CARELINE_ALLOW_ISOLATED_DB_TESTS
# are not required or used by the cleanup command.
